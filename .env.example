# ==============================================================================
# 🤖 1. MULTI-AGENT POOL (Google Gemini Flash + LiteLLM Load-Balancing & Failover)
# ==============================================================================
# Hỗ trợ cấu hình nhiều API Key từ nhiều tài khoản Gemini AI Studio miễn phí khác nhau.
# LiteLLM sẽ tự động Round-Robin, cân bằng tải và tự động đổi sang Key khác nếu dính 429.
GEMINI_KEY_1=AIzaSy_key_tai_khoan_1
GEMINI_KEY_2=AIzaSy_key_tai_khoan_2
GEMINI_KEY_3=AIzaSy_key_tai_khoan_3
GEMINI_KEY_4=AIzaSy_key_tai_khoan_4
GEMINI_KEY_5=AIzaSy_key_tai_khoan_5
GEMINI_KEY_6=AIzaSy_key_tai_khoan_6

# Hoặc điền danh sách cách nhau bởi dấu phẩy (tùy chọn):
GEMINI_API_KEYS=

# Cấu hình Model trong Pool
GEMINI_MODEL_NAME=gemini/gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
LITELLM_ROUTING_STRATEGY=usage-based-routing
LITELLM_NUM_RETRIES=3
LITELLM_COOLDOWN_TIME=60

# ==============================================================================
# 🎯 2. INSTRUCT & EMBEDDINGS (FPT AI Factory Custom API)
# ==============================================================================
# Dùng cho RAG Knowledge Base, Q&A kỹ thuật và Vector hóa dữ liệu vào Qdrant
FPT_AI_API_KEY=your_fpt_ai_factory_api_key_here
FPT_AI_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_INSTRUCT_MODEL_NAME=Llama-3.3-70B-Instruct
FPT_EMBEDDING_MODEL_NAME=multilingual-e5-large

# ==============================================================================
# 🗄️ 3. DATABASE & VECTOR STORE (TimescaleDB & Qdrant)
# ==============================================================================
TIMESCALE_URL=postgresql+asyncpg://postgres:postgres_secret@localhost:5432/iot_ground_truth
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_INCIDENT=incident_telemetry
QDRANT_COLLECTION_SOP=system_baselines_sop
QDRANT_COLLECTION_VERIFIED_PLANS=verified_action_plans

# ==============================================================================
# 🐰 4. RABBITMQ MESSAGE BROKER
# ==============================================================================
RABBITMQ_URI=amqp://guest:guest@localhost:5672/

# ==============================================================================
# 📡 5. OFFICIAL HACKATHON MQTT BROKER & TOPICS
# ==============================================================================
MQTT_BROKER_HOST=mqtt-hackathon.lexatek.vn
MQTT_BROKER_PORT=443
MQTT_USERNAME=your_mqtt_username_here
MQTT_PASSWORD=your_mqtt_password_here
MQTT_TOPIC_TELEMETRY=hackathon/veteran/test/telemetry
MQTT_TOPIC_TEST=hackathon/veteran/test/telemetry
MQTT_TOPIC_CONTROL=hackathon/smarthome/control
MQTT_USE_TLS=true
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_CLIENT_ID_PREFIX=veteran-smarthome-client

# ==============================================================================
# 🌐 6. APPLICATION BASE URL & EMAIL ALERTS
# ==============================================================================
DASHBOARD_BASE_URL=http://localhost:8000

# Cấu hình Email SMTP (Gmail App Password)
EMAIL_NOTIFICATION_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=aegis-iot@smarthome.ai
ALERT_RECIPIENT_EMAIL=homeowner@smarthome.ai
ALERT_RECIPIENT_EMAILS=homeowner@smarthome.ai
