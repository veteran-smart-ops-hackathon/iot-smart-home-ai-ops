# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Specific text files that must have LF line endings for Linux/Docker compatibility
*.sh text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf
Dockerfile text eol=lf
requirements.txt text eol=lf

# Windows batch files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
